{
  "ReverseProxy": {
    "Routes": {
      "work_swagger": {
        "ClusterId": "work",
        "Match": {
          "Path": "/work/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/work"
          }
        ]
      },
      "identity_swagger": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ]
      },
      "artifact_swagger": {
        "ClusterId": "artifact",
        "Match": {
          "Path": "/artifact/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/artifact"
          }
        ]
      },
      "identity_auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity_roles": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        },
        "AuthorizationPolicy": "AdminOnly"
      },
      "identity_users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "identity_admin": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "work": {
        "ClusterId": "work",
        "Match": {
          "Path": "/api/issues/{**remainder}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "work_root": {
        "ClusterId": "work",
        "Match": {
          "Path": "/api/issues"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "projects": {
        "ClusterId": "work",
        "Match": {
          "Path": "/api/projects/{**remainder}"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "projects_root": {
        "ClusterId": "work",
        "Match": {
          "Path": "/api/projects"
        },
        "AuthorizationPolicy": "Authenticated"
      },
      "artifact": {
        "ClusterId": "artifact",
        "Match": {
          "Path": "/api/artifacts/{**catch-all}"
        },
        "AuthorizationPolicy": "Authenticated"
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://forgeflow-identity:8080/"
          }
        }
      },
      "work": {
        "Destinations": {
          "d1": {
            "Address": "http://forgeflow-work:8080/"
          }
        }
      },
      "artifact": {
        "Destinations": {
          "d1": {
            "Address": "http://forgeflow-artifact:8080/"
          }
        }
      }
    }
  }
}